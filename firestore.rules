rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Primitives
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && request.auth.token.email == 'yeabserabruk1234@gmail.com';
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // 1. Services: Publicly readable, admin writeable
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Appointments: Admin can see all, users see their own
    match /appointments/{appointmentId} {
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 3. User Profiles: Admin can see all, users see/edit their own
    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if isAdmin() || isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || isOwner(userId);
    }

    // 4. Test connection
    match /test/{docId} {
      allow read: if true;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
